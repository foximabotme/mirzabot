{
    "name": "mirzapro/mirzabot",
    "description": "Mirza Bot - Telegram VPN sales and management bot",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "homepage": "https://github.com/mahdiMGF2/mirzabot",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-zip": "*",
        "endroid/qr-code": "^6.0",
        "phpoffice/phpspreadsheet": "^5.8"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "prefer-stable": true,
    "minimum-stability": "stable"
}
