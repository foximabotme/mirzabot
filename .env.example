# Telegram
BOT_TOKEN=123456789:replace_with_botfather_token
OWNER_ID=123456789
BOT_USERNAME=optional_without_at_sign
TELEGRAM_WEBHOOK_SECRET=replace_with_letters_numbers_underscores_or_dashes

# Railway sets RAILWAY_PUBLIC_DOMAIN after you generate a public domain.
# APP_DOMAIN can override it (without https://).
APP_DOMAIN=

# Reference the Railway MySQL service: ${{MySQL.MYSQL_URL}}
MYSQL_URL=mysql://user:password@host:3306/railway

# Protects /railway/transfer.php. Use a unique random value, at least 24 chars.
BACKUP_SECRET=replace_with_a_long_unique_random_secret

# A Railway Volume must be mounted at /data.
MIRZA_DATA_DIR=/data/mirzabot
